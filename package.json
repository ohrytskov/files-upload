{
  "name": "files-upload-repo",
  "version": "1.0.0",
  "description": "Full-stack file upload and management application built with Node.js, Express, React, and Vite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node --watch server.js",
    "dev": "vite",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:all": "npm test && npm run build",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "file-upload",
    "storage",
    "nodejs",
    "express",
    "react",
    "vite",
    "md5",
    "websocket",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "lucide-react": "^1.28.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.0"
  }
}
