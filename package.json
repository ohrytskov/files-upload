{
  "name": "files-upload-repo",
  "version": "1.0.0",
  "description": "Full-stack file upload and management application built with Node.js, Express, React, and Vite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node --watch server.js",
    "dev": "vite",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "test:frontend": "vitest run",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "test:all": "npm run lint && npm test && npm run test:frontend && npm run build",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "node bin/deploy.js",
    "local-copy": "node bin/local-copy.js",
    "download": "node bin/download-cli.js"
  },
  "keywords": [
    "file-upload",
    "storage",
    "nodejs",
    "express",
    "react",
    "vite",
    "md5",
    "websocket",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "lucide-react": "^1.28.0",
    "multer": "^1.4.5-lts.1",
    "pdf-to-png-converter": "4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
